# Vicare Healthcare Multi-Hospital FastAPI Backend
PROJECT_NAME="Vicare Healthcare API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security
SECRET_KEY="generate-a-strong-secret-key-for-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="vicare_user"
POSTGRES_PASSWORD="vicare_password"
POSTGRES_DB="vicare_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# CORS Origins
BACKEND_CORS_ORIGINS='["*"]'
